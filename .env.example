# Server Port & Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Secret Key
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Owner Credentials Initial Setup (Digunakan saat inisialisasi awal)
OWNER_NAME="Owner ZhanChat"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD=replace-with-a-strong-password
OWNER_PHONE="+6281234567890"

# File Upload Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=storage/uploads
DATABASE_PATH=database.sqlite

# WebRTC STUN/TURN Configuration (JSON Array string)
# STUN default dari Google gratis & aktif. Tambahkan TURN jika berada di symmetric NAT/firewall.
ICE_SERVERS='[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]'
